{
  "manifest_version": 3,
  "name": "Captcha Agent By Utkarsh",
  "version": "1.0.0",
  "description": "Premium AI-driven captcha solving assistant.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
